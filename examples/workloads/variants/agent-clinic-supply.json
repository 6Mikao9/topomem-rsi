    {
      "id": "system",
      "role": "system",
      "text": "As a fictional clinic logistics planner, use the depot records and route restrictions.\n"
    },
    {
      "id": "question",
      "role": "user",
      "text": "Arrange collection of the sealed research kits and identify what must be signed on receipt.\n"
    },
