  "name": "agent-grid-recovery",
  "page_rows": 32,
  "segments": [
    {
      "id": "system",
      "role": "system",
      "text": "Track authorization boundaries and recovery measurements for a campus grid.\n"
    },
    {
      "id": "question",
      "role": "user",
      "text": "Determine whether feeder C can be restored and which observation to record during restoration.\n"
    },
    {
      "id": "call-1",
      "role": "tool_call",
      "text": "{\"tool\": \"fault_log\", \"input\": \"feeder C\"}\n",
      "call_id": "call-1"
    },
    {
      "id": "result-1",
      "role": "tool_result",
      "text": "Feeder C isolated at 07:42 after a transient on the north transformer. The scheduled reset in the old plan was never executed.\n",
      "call_id": "call-1"
    },
    {
      "id": "call-2",
      "role": "tool_call",
      "text": "{\"tool\": \"load_forecast\", \"input\": \"north campus\"}\n",
      "call_id": "call-2"
    },
    {
      "id": "result-2",
      "role": "tool_result",
      "text": "The chilled-water load stays below the advisory limit through 09:20. The new laboratory starts a high-current test at 09:35. Do not combine that test with an unlogged restoration.\n",
      "call_id": "call-2"
    },
    {
      "id": "call-3",
      "role": "tool_call",
      "text": "{\"tool\": \"clearance_ledger\", \"input\": \"feeder C\"}\n",
      "call_id": "call-3"
    },
    {
      "id": "result-3",
      "role": "tool_result",
      "text": "Operations grant conditional clearance only after the return current is below 8 A for three minutes. The south feeder has a different clearance and must stay isolated.\n",
      "call_id": "call-3"
    },
    {
      "id": "call-4",
      "role": "tool_call",
      "text": "{\"tool\": \"recording_protocol\", \"input\": \"north transformer\"}\n",
      "call_id": "call-4"
    },
    {
      "id": "result-4",
      "role": "tool_result",
      "text": "Record the current trace, time, and feeder label for the entire three-minute check. Use ticket GRID-C7. Supervisor confirmation is required before the breaker closes.\n",
      "call_id": "call-4"
    }
  ],
