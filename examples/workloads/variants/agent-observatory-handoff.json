  "segments": [
    {
      "id": "system",
      "role": "system",
      "text": "Work from signed field observations when planning an observatory handoff.\n"
    },
    {
      "id": "question",
      "role": "user",
      "text": "Find the receiver that can stay powered overnight, its clean interval, and the duty contact.\n"
    },
    {
      "id": "call-1",
      "role": "tool_call",
      "text": "{\"tool\": \"receiver_registry\", \"input\": \"night operation\"}\n",
      "call_id": "call-1"
    },
    {
      "id": "result-1",
      "role": "tool_result",
      "text": "Receiver R4 is approved with the low-noise supply. Receiver R7 remains locked after the fan alarm.\n",
      "call_id": "call-1"
    },
    {
      "id": "call-2",
      "role": "tool_call",
      "text": "{\"tool\": \"interference_log\", \"input\": \"R4\"}\n",
      "call_id": "call-2"
    },
    {
      "id": "result-2",
      "role": "tool_result",
      "text": "The current spectrum sweep shows a clean interval of 02:35 to 03:25 UTC. The first interval on the schedule was superseded when the neighboring uplink restarted.\n",
      "call_id": "call-2"
    },
    {
      "id": "call-3",
      "role": "tool_call",
      "text": "{\"tool\": \"duty_roster\", \"input\": \"clean interval\"}\n",
      "call_id": "call-3"
    },
    {
      "id": "result-3",
      "role": "tool_result",
      "text": "Duties transfer at 03:00. Before transfer, the active pager is Quarry. After transfer, use Lakeside and include observation ticket 52.\n",
      "call_id": "call-3"
    }
  ],
